{
	"name": "@puruvj/builder-sdk-svelte",
	"version": "0.0.10",
	"description": "A hot-path-proof, scale-proof Builder.io renderer for Svelte 5 — a drop-in for @builder.io/sdk-svelte",
	"license": "MIT",
	"author": "Puru Vijayvargia",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/PuruVJ/builder-sdk-svelte.git"
	},
	"keywords": [
		"builder.io",
		"svelte",
		"sveltekit",
		"cms",
		"ssr",
		"performance"
	],
	"type": "module",
	"packageManager": "pnpm@12.16.1",
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"typesVersions": {
		"*": {
			"src/*": [
				"dist/official/*"
			],
			"bundle/*": [
				"dist/index.d.ts"
			],
			"browser": [
				"dist/index.d.ts"
			],
			"node": [
				"dist/index.d.ts"
			],
			"edge": [
				"dist/index.d.ts"
			]
		}
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./bundle/browser": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./bundle/node": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./bundle/edge": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./browser": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./node": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./edge": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./src/*.js": {
			"types": "./dist/official/*.d.ts"
		},
		"./src/*": {
			"types": "./dist/official/*.d.ts"
		},
		"./package.json": "./package.json"
	},
	"files": [
		"dist"
	],
	"sideEffects": [
		"**/*.css"
	],
	"scripts": {
		"build": "tsdown && node scripts/check-dist-svelte.mjs && node scripts/check-dist-bundle.mjs",
		"prepublishOnly": "pnpm build",
		"changeset": "changeset",
		"changeset:version": "changeset version && pnpm install --lockfile-only",
		"changeset:publish": "changeset publish",
		"fixtures": "node scripts/gen-fixtures.mjs",
		"pretest": "pnpm fixtures && pnpm bench:build",
		"test": "vitest run",
		"test:unit": "vitest run tests/unit",
		"test:coverage": "vitest run --coverage tests/unit",
		"bench:build": "vite build --config bench/vite.ssr.config.ts",
		"bench:ssr": "node bench/ssr.mjs",
		"bench:app": "node --expose-gc bench/app-page.mjs",
		"bench:client": "node bench/client.mjs",
		"e2e:build": "pnpm --filter ./e2e/suite build && pnpm --filter ./e2e/app build:official && pnpm --filter ./e2e/app build:ours",
		"e2e:official": "cd e2e/suite && SERVER_NAME=sveltekit BUILDER_SDK=official TEST_TYPE=e2e playwright test",
		"e2e:ours": "cd e2e/suite && SERVER_NAME=sveltekit BUILDER_SDK=ours TEST_TYPE=e2e playwright test",
		"e2e:build:async": "pnpm --filter ./e2e/suite build && pnpm --filter ./e2e/app build:ours:async",
		"e2e:build:official:async": "pnpm --filter ./e2e/suite build && pnpm --filter ./e2e/app build:official:async",
		"e2e:ours:async": "cd e2e/suite && SERVER_NAME=sveltekit BUILDER_SDK=ours SVELTE_ASYNC=1 TEST_TYPE=e2e playwright test",
		"e2e:official:async": "cd e2e/suite && SERVER_NAME=sveltekit BUILDER_SDK=official SVELTE_ASYNC=1 TEST_TYPE=e2e playwright test",
		"test:editor-fuzz": "vitest run tests/editor-fuzz.test.ts",
		"test:async-ssr": "pnpm bench:build && vite build --config bench/vite.ssr.async.config.ts && vitest run tests/async-ssr.test.ts"
	},
	"peerDependencies": {
		"svelte": "^5.30.0"
	},
	"devDependencies": {
		"@builder.io/sdk-svelte": "5.2.0",
		"@builder.io/sdk-svelte-latest": "npm:@builder.io/sdk-svelte@5.4.2",
		"@changesets/changelog-github": "^1.0.1",
		"@changesets/cli": "^3.0.3",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"@types/node": "^22.20.4",
		"@vitest/coverage-v8": "3.2.7",
		"happy-dom": "^21.0.4",
		"parse5": "^8.0.1",
		"playwright": "^1.62.1",
		"svelte": "^5.56.8",
		"svelte-check": "^4.7.8",
		"svelte2tsx": "^0.7.61",
		"tinybench": "^6.2.0",
		"tsdown": "^0.23.0",
		"typescript": "^5.9.3",
		"vite": "^7.3.6",
		"vitest": "^3.2.7"
	},
	"publishConfig": {
		"access": "public",
		"provenance": true
	}
}
